
import numpy as np

# Dummy dataset: [size, rooms, location_value]
np.random.seed(42)
X = np.random.rand(100, 3)
y = (5 + 20*X[:, 0] + 3*X[:, 1] + 10*X[:, 2]).reshape(-1, 1)

# Normalize data
X = (X - X.mean(axis=0)) / X.std(axis=0)
y = (y - y.mean()) / y.std()

# Initialize weights
W1 = np.random.randn(3, 5) * 0.1
b1 = np.zeros((1, 5))
W2 = np.random.randn(5, 1) * 0.1
b2 = np.zeros((1, 1))

lr = 0.01

# Training using backpropagation
for epoch in range(5000):
    # Forward propagation
    hidden = np.tanh(X @ W1 + b1)
    output = hidden @ W2 + b2

    # Error
    error = output - y
    loss = np.mean(error ** 2)

    # Backpropagation
    d_output = 2 * error / len(X)
    dW2 = hidden.T @ d_output
    db2 = np.sum(d_output, axis=0, keepdims=True)

    d_hidden = (d_output @ W2.T) * (1 - hidden ** 2)
    dW1 = X.T @ d_hidden
    db1 = np.sum(d_hidden, axis=0, keepdims=True)

    # Update weights
    W2 -= lr * dW2
    b2 -= lr * db2
    W1 -= lr * dW1
    b1 -= lr * db1

    if epoch % 1000 == 0:
        print("Epoch:", epoch, "Loss:", loss)

# Prediction
prediction = np.tanh(X[:1] @ W1 + b1) @ W2 + b2
print("Predicted normalized house price:", prediction[0, 0])
